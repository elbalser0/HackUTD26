# Copy to .env and fill in values. Never commit .env.
#
# WARNING: Any variable prefixed with VITE_ is bundled into the frontend
# and is PUBLIC. Never put secrets in VITE_* variables.

# --- Frontend (public) ---
# Base URL of the backend API, once one exists.
VITE_API_BASE_URL=http://localhost:8000

# --- Backend (server-only secrets; not read by the frontend) ---
# Add backend secrets here once the challenge brief/backend contract is set.
# PORT=8000
# DATABASE_URL=

# Admin log API (/api/admin/*). Shared fallback credential. Unset = shared token disabled. Long random value; never commit it.
# BG_ADMIN_TOKEN=

# Firebase (Google) sign-in. The project id is PUBLIC (not a secret). Setting it makes web writes require sign-in,
# so only set it once the UI sends Firebase ID tokens. Admin emails: comma-separated, case-insensitive.
# BG_FIREBASE_PROJECT_ID=
# BG_ADMIN_EMAILS=you@example.com,friend@example.com

# --- Frontend Firebase web config (PUBLIC identifiers from Firebase console > Project settings > Your apps) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- Tiger Cloud (PostgreSQL + TimescaleDB) -------------------------------------------------
# Unset = explicit offline SQLite at BG_DB_PATH. Set = PostgreSQL for BOTH the API and the CLI,
# with no fallback if it is unreachable. Use a runtime role without DDL rights; run
# `breakglass migrate-schema` once with a DDL-capable URL. Never put this in a VITE_* variable.
# BG_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
